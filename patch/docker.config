# Floran Kernel - Docker 容器支持（单一开关 docker=true 时整体追加）
#
# 开启项：文件本身即清单（见下方分组），对应 docker check-config.sh 报告
# 缺失的 namespaces/seccomp、cgroup v2 控制器、USER_NS、overlay/btrfs 存储驱动等。
#
# ⚠️ DANGER：本片段会改变内核行为，可能导致部分机型 bootloop，请先在自有
# 设备上实测开机后再分发。已在 OnePlus Ace 3 Pro (pineapple/sm8650, GKI 6.1)
# 验证可开机并完整跑通 Docker；其他平台未经测试。
#
# 有意 NOT 开启（在 sm8650/pineapple 上单变量二分实测确认会 bootloop）：
#   - 网络簇 bridge/nftables/IPVS/SCTP/XFRM：把原厂 =m 网络组件翻成 =y，
#     破坏高通网络 vendor 模块 probe。
#   - CONFIG_CFS_BANDWIDTH：改变调度结构体布局，vendor 模块按偏移内嵌引用错乱。
#   - cgroup 可选/遗留簇 PERF/HUGETLB/NET_CLS/NETCLASSID：同类结构体扰动。
#   使用后果：容器网络请用 --network=host（无 docker0/NAT/-p 端口映射），
#   CPU 限制请用 --cpu-shares / cpu.weight 相对权重代替 --cpus。

# ---- namespaces & seccomp ----
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_POSIX_MQUEUE=y

# ---- user namespace (rootless / --userns-remap) ----
CONFIG_USER_NS=y

# ---- cgroup 基础控制器 ----
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CGROUP_NET_PRIO=y

# ---- 事件 / 同步原语 ----
CONFIG_KEYS=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_INET=y

# ---- overlay 存储驱动 (Docker 默认 storage driver) ----
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

# ---- btrfs 存储驱动支持 ----
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
