# Floran Kernel - Docker 支持：安全核心底座（始终追加）
# 说明：下面这些项在 crDroid 的 gki_defconfig 里基本已是 =y，或被 NAMESPACES /
# CGROUPS / arm64 默认自动选中，追加它们对最终 .config 没有实质改动，因此作为
# 安全底座无条件保留。
# 真正会改变内核行为、可能触发 bootloop 的两批被拆到独立开关：
#   patch/docker-cgroup.config  -> 由 docker_cgroup 控制（额外 cgroup 控制器/CFS带宽/cls_cgroup/USER_NS）
#   patch/docker-fs.config      -> 由 docker_fs    控制（BTRFS 存储驱动）
# 高级网络（bridge/nftables/ipvs/sctp/xfrm）在 patch/docker-net.config，由 docker_net 控制。

# ---- namespaces & seccomp (GKI 随 NAMESPACES 默认已开) ----
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_POSIX_MQUEUE=y

# ---- cgroup 基础控制器 (GKI 原生已 =y) ----
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CGROUP_NET_PRIO=y

# ---- 事件 / 同步原语 (arm64 默认已开) ----
CONFIG_KEYS=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_INET=y

# ---- overlay 存储驱动 (Docker 默认 storage driver，GKI 已 =y) ----
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
