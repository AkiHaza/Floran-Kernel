# Floran Kernel - Virtual Machine (KVM host) support（手动片段，未接入 CI 选项）
# 目标：让 arm64 主机可运行 KVM 虚拟机（QEMU/firecracker 等），
# 并为 virtio 半虚拟化设备与 9p 文件共享准备宿主侧支持。
#
# 为什么不提供 workflow 开关：arm64 KVM 宿主必须让 Linux 运行在 EL2，
# 而高通等移动平台的 EL2 常被 OEM monitor / pKVM 占用，Linux 只能以 EL1
# guest 启动，此时即使 CONFIG_KVM=y，kvm_init 的 has_hyp_mode() 检查失败，
# /dev/kvm 也不会注册（判据：cat /proc/misc | grep kvm）。实测 OnePlus
# Ace 3 Pro (sm8650/pineapple) 即属此情况：能开机但本机无法做 KVM 宿主。
# 是否可用高度依赖 SoC/固件，开关进 UI 只会引导用户刷入砖机风险配置，
# 故仅保留本片段供确认自己设备 EL2 可用者在本地构建时手动追加：
#   cat patch/vm.config >> arch/arm64/configs/gki_defconfig

# ---- KVM 宿主 ----
CONFIG_KVM=y
CONFIG_HAVE_KVM=y

# ---- 网络设备（VM 网桥 / tap） ----
CONFIG_TUN=y
CONFIG_TAP=y
CONFIG_VHOST=y
CONFIG_VHOST_NET=y

# ---- virtio 半虚拟化设备 ----
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y

# ---- 9p / virtio-fs 文件共享 ----
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# ---- 串口 / pty（VM console） ----
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
