# Floran Kernel - Virtual Machine (KVM host) support
# 该片段在 vm 开关开启时被追加到 arch/arm64/configs/gki_defconfig。
# 目标：让 arm64 主机可运行 KVM 虚拟机（QEMU/firecracker 等），
# 并为 virtio 半虚拟化设备与 9p 文件共享准备宿主侧支持。
#
# 注意：高通/pineapple 平台可能默认启用 pKVM（protected KVM），
# 此时 CONFIG_KVM 宿主接口会受限。该开关独立可选，若导致无法启动
# 请在构建时关闭 vm 开关。

# ---- KVM 宿主 ----
CONFIG_KVM=y
CONFIG_HAVE_KVM=y

# ---- 网络设备（VM 网桥 / tap） ----
CONFIG_TUN=y
CONFIG_TAP=y
CONFIG_VHOST=y
CONFIG_VHOST_NET=y

# ---- virtio 半虚拟化设备 ----
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y

# ---- 9p / virtio-fs 文件共享 ----
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# ---- 串口 / pty（VM console） ----
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
